# Cloudflare 정적 자산 캐시 정책
#
# Vite 산출물의 /assets/* 는 파일명에 해시가 붙으므로 영구 캐시해도 안전하다.
# HTML 은 매번 최신을 받아야 새 빌드가 즉시 반영된다.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 3D 모델. 내용이 바뀌면 파일명 뒤 버전을 올린다(models/world-forest.v2.glb).
# 매 판 수 MB 를 다시 받게 하면 교실 와이파이에서 게임이 안 켜진다.
/models/*
  Cache-Control: public, max-age=31536000, immutable

/audio/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache
