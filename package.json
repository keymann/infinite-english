{
  "name": "infinite-english",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "무한 계단 스타일 3D 영어 어휘 학습 게임 (Cloudflare Workers)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "assets": "node tools/optimize-assets.mjs",
    "test": "vitest run",
    "words": "tsx tools/build-words.ts"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
